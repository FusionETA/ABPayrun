# ── ABPay server ──────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# JWT signing secret for ABPay's OWN sessions. Generate a long random
# string, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Cookie name that carries the ABPay session JWT
SESSION_COOKIE=abpay_session
# AES-256-GCM key (hex) for encrypting stored wp_live tokens. openssl rand -hex 32
TOKEN_ENC_KEY=change-me-64-hex-chars

# ── AltomateHR integration ────────────────────────────────────────────
# Base URL of the AltomateHR app (no trailing slash)
ALTOMATE_BASE_URL=https://hr.altomate.io

# App-level credential for the identity endpoints (/auth/verify,
# /auth/organizations). PREFERRED: a platform master key (wp_master_...),
# which authenticates ABPay across ALL the owner's orgs and isn't tied to
# any single company's token lifecycle. A per-org wp_live_ token also works
# (backward-compat). This is NOT used to read payroll data — that uses the
# per-company tokens below.
ALTOMATE_AUTH_TOKEN=wp_master_xxx

# ── Per-company AltomateHR API tokens (one org each) ──────────────────
# Each Ayu Borneo company is a separate AltomateHR organization with its
# own wp_live_* token. These authorise the actual payroll reads/writes.
ALTOMATE_TOKEN_ABSA=wp_live_xxx
ALTOMATE_TOKEN_ABM=wp_live_xxx
ALTOMATE_TOKEN_ABSB=wp_live_xxx
ALTOMATE_TOKEN_ABAP=wp_live_xxx
ALTOMATE_TOKEN_ABPJ=wp_live_xxx

# ── Database (DigitalOcean managed MySQL) ────────────────────────────
DB_HOST=your-db-host.ondigitalocean.com
DB_PORT=25060
DB_USER=doadmin
DB_PASSWORD=your-db-password
DB_NAME=ab_pay
DB_SSL=REQUIRED
# Optional: path to DigitalOcean's CA cert PEM for full TLS verification.
# DB_CA_CERT=./certs/do-ca.crt
